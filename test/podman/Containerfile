FROM docker.io/library/debian:sid

ARG WITH_UV=0

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      neovim python3 python3-venv python3-pip curl ca-certificates procps \
 && rm -rf /var/lib/apt/lists/*

# WITH_UV=1 adds uv to PATH for the uv-install path. The default image has no
# uv, so the plugin falls back to a python3 venv.
RUN if [ "$WITH_UV" = "1" ]; then pip3 install --break-system-packages uv; fi

# Fresh HOME, owned by the host user that --userns=keep-id maps in (uid 1000).
ENV HOME=/tmp/home
RUN mkdir -p /tmp/home && chmod 0777 /tmp/home

WORKDIR /src
ENTRYPOINT ["bash", "test/podman/run.sh"]
